{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "incremental": false,
    "composite": false,
    "outDir": ".mc-build",
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts"]
}
